Screen {
    background: $surface;
}

#panels {
    padding: 0 1;
    height: 1fr;
}

/* Sits under both panels. `height: auto` lets it wrap to two or three lines on
   a narrow terminal instead of being cropped — vertical space is cheap here,
   horizontal space is not. */
#legend {
    height: auto;
    padding: 0 2;
    margin: 1 1 0 1;
}

ProviderPanel {
    height: auto;
    border: round $panel-lighten-2;
    border-title-color: $text;
    border-title-style: bold;
    border-subtitle-color: $text-muted;
    padding: 1 2;
    margin: 1 0 0 0;
}

GaugeBar {
    height: 1;
}

.issue {
    height: auto;
    padding: 0 1;
}
